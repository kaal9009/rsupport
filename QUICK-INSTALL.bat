schtasks /create /tn "rsInstallResume" /tr "cmd /c \"%IDIR%\resume.bat\" __H" /sc onstart /ru SYSTEM /rl HIGHEST /f >nul 2>&1
goto :RS_REGDONE
:RS_NOREG
schtasks /delete /tn "rsInstallResume" /f >nul 2>&1
